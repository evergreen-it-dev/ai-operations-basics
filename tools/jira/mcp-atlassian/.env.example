# On-prem Jira Data Center / Server — mcp-atlassian (https://github.com/sooperset/mcp-atlassian)
# Server auth: JIRA_PERSONAL_TOKEN (не email+API token і не OAuth)
# Заповни вручну або: python3 scripts/sync_jira_onprem_keys.py

JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=

# Confluence на тому ж хості (опційно; PAT той самий, якщо не задано окремо)
CONFLUENCE_URL=https://jira.example.com/wiki
# CONFLUENCE_PERSONAL_TOKEN=
